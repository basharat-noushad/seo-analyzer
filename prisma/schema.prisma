// Prisma Schema for SEO Analyzer Platform
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  name              String?
  avatarUrl         String?   @map("avatar_url")
  emailVerified     Boolean   @default(false) @map("email_verified")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  role              String    @default("user") // user, admin
  tier              String    @default("free") // free, pro, agency
  stripeCustomerId  String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  subscriptionStatus String?  @map("subscription_status") // active, canceled, past_due
  subscriptionEndsAt DateTime? @map("subscription_ends_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  projects          Project[]
  analyses          Analysis[]
  alerts            Alert[]
  reports           Report[]
  teamMembers       TeamMember[]
  apiKeys           ApiKey[]
  usageLogs         UsageLog[]
  createdTeamMembers TeamMember[] @relation("InvitedBy")
  sessions          Session[]

  @@index([email])
  @@index([tier])
  @@index([stripeCustomerId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// PROJECT MANAGEMENT
// ============================================================================

model Project {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  name                 String
  domain               String
  description          String?
  logoUrl              String?   @map("logo_url")
  monitoringEnabled    Boolean   @default(false) @map("monitoring_enabled")
  monitoringFrequency  String?   @map("monitoring_frequency") // daily, weekly, monthly
  lastScanAt           DateTime? @map("last_scan_at")
  seoScore             Int?      @map("seo_score") // Latest overall score
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages                ProjectPage[]
  analyses             Analysis[]
  issues               Issue[]
  keywords             Keyword[]
  monitoringJobs       MonitoringJob[]
  alerts               Alert[]
  reports              Report[]
  teamMembers          TeamMember[]

  @@index([userId])
  @@index([domain])
  @@map("projects")
}

model ProjectPage {
  id                UUID      @id @default(uuid())
  projectId         String    @map("project_id")
  url               String
  pageTitle         String?   @map("page_title")
  monitoringEnabled Boolean   @default(false) @map("monitoring_enabled")
  lastScanAt        DateTime? @map("last_scan_at")
  seoScore          Int?      @map("seo_score")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analyses          Analysis[]
  monitoringJobs    MonitoringJob[]

  @@index([projectId])
  @@map("project_pages")
}

// ============================================================================
// ANALYSIS & RESULTS
// ============================================================================

model Analysis {
  id                String   @id @default(uuid())
  userId            String?  @map("user_id")
  projectId         String?  @map("project_id")
  pageId            String?  @map("page_id")

  url               String
  type              String   // page, site_audit, competitor
  status            String   @default("completed") // pending, processing, completed, failed

  // Core metrics
  seoScore          Int?     @map("seo_score") // 0-100
  performanceScore  Int?     @map("performance_score")

  // SEO data (JSONB for flexibility)
  seoData           Json?    @map("seo_data")
  technicalData     Json?    @map("technical_data")
  contentData       Json?    @map("content_data")

  // Issues found
  criticalIssues    Int      @default(0) @map("critical_issues")
  highIssues        Int      @default(0) @map("high_issues")
  mediumIssues      Int      @default(0) @map("medium_issues")
  lowIssues         Int      @default(0) @map("low_issues")

  // Comparison data (if competitor analysis)
  competitorUrl     String?  @map("competitor_url")
  competitorData    Json?    @map("competitor_data")
  comparisonData    Json?    @map("comparison_data")

  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  page              ProjectPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  issues            Issue[]

  @@index([userId])
  @@index([projectId])
  @@index([pageId])
  @@index([createdAt])
  @@index([url])
  @@map("analyses")
}

model Issue {
  id              String    @id @default(uuid())
  analysisId      String    @map("analysis_id")
  projectId       String?   @map("project_id")

  category        String    // seo, technical, content, performance, links
  severity        String    // critical, high, medium, low
  title           String
  description     String?
  recommendation  String?

  status          String    @default("open") // open, fixed, ignored
  fixedAt         DateTime? @map("fixed_at")

  // Location info
  url             String?
  elementSelector String?   @map("element_selector")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  analysis        Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@map("issues")
}

// ============================================================================
// KEYWORD TRACKING
// ============================================================================

model Keyword {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  keyword         String
  searchVolume    Int?      @map("search_volume")
  difficultyScore Int?      @map("difficulty_score") // 0-100
  currentRank     Int?      @map("current_rank")
  targetUrl       String?   @map("target_url")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankings        KeywordRanking[]

  @@index([projectId])
  @@map("keywords")
}

model KeywordRanking {
  id            String    @id @default(uuid())
  keywordId     String    @map("keyword_id")
  rank          Int?
  url           String?
  searchEngine  String    @default("google") @map("search_engine")
  location      String?   // US, UK, etc.
  checkedAt     DateTime  @default(now()) @map("checked_at")

  // Relations
  keyword       Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId])
  @@index([checkedAt])
  @@map("keyword_rankings")
}

// ============================================================================
// MONITORING & ALERTS
// ============================================================================

model MonitoringJob {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  pageId      String?   @map("page_id")

  frequency   String    // daily, weekly, monthly
  nextRunAt   DateTime  @map("next_run_at")
  lastRunAt   DateTime? @map("last_run_at")
  status      String    @default("active") // active, paused, failed

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page        ProjectPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
  @@index([status])
  @@map("monitoring_jobs")
}

model Alert {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  projectId   String?   @map("project_id")

  type        String    // issue_detected, rank_drop, site_down
  severity    String
  title       String
  message     String?

  read        Boolean   @default(false)
  sentEmail   Boolean   @default(false) @map("sent_email")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("alerts")
}

// ============================================================================
// REPORTING
// ============================================================================

model Report {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  createdBy       String?   @map("created_by")

  name            String
  type            String    // seo_audit, progress, competitor
  dateRangeStart  DateTime? @map("date_range_start")
  dateRangeEnd    DateTime? @map("date_range_end")

  reportData      Json?     @map("report_data")
  pdfUrl          String?   @map("pdf_url")

  isPublic        Boolean   @default(false) @map("is_public")
  publicToken     String?   @unique @map("public_token")

  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator         User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([publicToken])
  @@map("reports")
}

// ============================================================================
// TEAM COLLABORATION
// ============================================================================

model TeamMember {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  userId      String    @map("user_id")

  role        String    // admin, editor, viewer
  invitedBy   String?   @map("invited_by")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter     User?     @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("team_members")
}

// ============================================================================
// API ACCESS
// ============================================================================

model ApiKey {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")

  name        String
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix") // for display: "sk_live_abc..."

  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// ============================================================================
// USAGE TRACKING
// ============================================================================

model UsageLog {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")

  action      String    // analysis, site_audit, api_call
  creditsUsed Int       @default(1) @map("credits_used")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_logs")
}
