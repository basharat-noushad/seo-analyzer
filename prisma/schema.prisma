// Prisma Schema for SEO Analyzer Platform
// Database: PostgreSQL (Neon Serverless)

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  name              String?
  avatarUrl         String?   @map("avatar_url")
  emailVerified     Boolean   @default(false) @map("email_verified")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  role              String    @default("user") // user, admin
  tier              String    @default("free") // free, pro, agency
  stripeCustomerId  String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  subscriptionStatus String?  @map("subscription_status") // active, canceled, past_due
  subscriptionEndsAt DateTime? @map("subscription_ends_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  projects          Project[]
  analyses          Analysis[]
  alerts            Alert[]
  reports           Report[]
  ownedTeams        Team[]       @relation("TeamOwner")
  teamMembers       TeamMember[]
  createdTeamMembers TeamMember[] @relation("InvitedBy")
  sentInvitations   TeamInvitation[] @relation("InvitedTeamMember")
  addedProjects     TeamProject[] @relation("ProjectAdder")
  activityLogs      ActivityLog[] @relation("UserActivities")
  apiKeys           ApiKey[]
  webhooks          Webhook[]    @relation("UserWebhooks")
  usageLogs         UsageLog[]
  sessions          Session[]

  @@index([email])
  @@index([tier])
  @@index([stripeCustomerId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// PROJECT MANAGEMENT
// ============================================================================

model Project {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  name                 String
  domain               String
  description          String?
  logoUrl              String?   @map("logo_url")
  monitoringEnabled    Boolean   @default(false) @map("monitoring_enabled")
  monitoringFrequency  String?   @map("monitoring_frequency") // daily, weekly, monthly
  lastScanAt           DateTime? @map("last_scan_at")
  seoScore             Int?      @map("seo_score") // Latest overall score
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages                ProjectPage[]
  analyses             Analysis[]
  issues               Issue[]
  keywords             Keyword[]
  monitoringJobs       MonitoringJob[]
  alerts               Alert[]
  reports              Report[]
  teamMembers          TeamMember[]
  teamProjects         TeamProject[] @relation("TeamProjects")

  @@index([userId])
  @@index([domain])
  @@map("projects")
}

model ProjectPage {
  id                String    @id @default(uuid())
  projectId         String    @map("project_id")
  url               String
  pageTitle         String?   @map("page_title")
  monitoringEnabled Boolean   @default(false) @map("monitoring_enabled")
  lastScanAt        DateTime? @map("last_scan_at")
  seoScore          Int?      @map("seo_score")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analyses          Analysis[]
  monitoringJobs    MonitoringJob[]

  @@index([projectId])
  @@map("project_pages")
}

// ============================================================================
// ANALYSIS & RESULTS
// ============================================================================

model Analysis {
  id                String   @id @default(uuid())
  userId            String?  @map("user_id")
  projectId         String?  @map("project_id")
  pageId            String?  @map("page_id")

  url               String
  type              String   // page, site_audit, competitor
  status            String   @default("completed") // pending, processing, completed, failed

  // Core metrics
  seoScore          Int?     @map("seo_score") // 0-100
  performanceScore  Int?     @map("performance_score")

  // SEO data (JSONB for flexibility)
  seoData           Json?    @map("seo_data")
  technicalData     Json?    @map("technical_data")
  contentData       Json?    @map("content_data")

  // Issues found
  criticalIssues    Int      @default(0) @map("critical_issues")
  highIssues        Int      @default(0) @map("high_issues")
  mediumIssues      Int      @default(0) @map("medium_issues")
  lowIssues         Int      @default(0) @map("low_issues")

  // Comparison data (if competitor analysis)
  competitorUrl     String?  @map("competitor_url")
  competitorData    Json?    @map("competitor_data")
  comparisonData    Json?    @map("comparison_data")

  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  page              ProjectPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  issues            Issue[]

  @@index([userId])
  @@index([projectId])
  @@index([pageId])
  @@index([createdAt])
  @@index([url])
  @@map("analyses")
}

model Issue {
  id              String    @id @default(uuid())
  analysisId      String    @map("analysis_id")
  projectId       String?   @map("project_id")

  category        String    // seo, technical, content, performance, links
  severity        String    // critical, high, medium, low
  title           String
  description     String?
  recommendation  String?

  status          String    @default("open") // open, fixed, ignored
  fixedAt         DateTime? @map("fixed_at")

  // Location info
  url             String?
  elementSelector String?   @map("element_selector")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  analysis        Analysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@map("issues")
}

// ============================================================================
// KEYWORD TRACKING
// ============================================================================

model Keyword {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  keyword         String
  searchVolume    Int?      @map("search_volume")
  difficultyScore Int?      @map("difficulty_score") // 0-100
  currentRank     Int?      @map("current_rank")
  targetUrl       String?   @map("target_url")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rankings        KeywordRanking[]

  @@index([projectId])
  @@map("keywords")
}

model KeywordRanking {
  id            String    @id @default(uuid())
  keywordId     String    @map("keyword_id")
  rank          Int?
  url           String?
  searchEngine  String    @default("google") @map("search_engine")
  location      String?   // US, UK, etc.
  checkedAt     DateTime  @default(now()) @map("checked_at")

  // Relations
  keyword       Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId])
  @@index([checkedAt])
  @@map("keyword_rankings")
}

// ============================================================================
// MONITORING & ALERTS
// ============================================================================

model MonitoringJob {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  pageId      String?   @map("page_id")

  frequency   String    // daily, weekly, monthly
  nextRunAt   DateTime  @map("next_run_at")
  lastRunAt   DateTime? @map("last_run_at")
  status      String    @default("active") // active, paused, failed

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page        ProjectPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
  @@index([status])
  @@map("monitoring_jobs")
}

model Alert {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  projectId   String?   @map("project_id")

  type        String    // issue_detected, rank_drop, site_down
  severity    String
  title       String
  message     String?

  read        Boolean   @default(false)
  sentEmail   Boolean   @default(false) @map("sent_email")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("alerts")
}

// ============================================================================
// REPORTING
// ============================================================================

model Report {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  createdBy       String?   @map("created_by")

  name            String
  type            String    // seo_audit, progress, competitor
  dateRangeStart  DateTime? @map("date_range_start")
  dateRangeEnd    DateTime? @map("date_range_end")

  reportData      Json?     @map("report_data")
  pdfUrl          String?   @map("pdf_url")

  isPublic        Boolean   @default(false) @map("is_public")
  publicToken     String?   @unique @map("public_token")

  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator         User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([publicToken])
  @@map("reports")
}

// ============================================================================
// TEAM COLLABORATION
// ============================================================================

model Team {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?

  ownerId       String    @map("owner_id")
  plan          String    @default("free") // free, team, enterprise

  logoUrl       String?   @map("logo_url")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  owner         User      @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  invitations   TeamInvitation[]
  projects      TeamProject[]
  activityLogs  ActivityLog[]

  @@index([ownerId])
  @@index([slug])
  @@map("teams")
}

model TeamMember {
  id          String    @id @default(uuid())
  teamId      String    @map("team_id")
  projectId   String?   @map("project_id")
  userId      String    @map("user_id")

  role        String    // owner, admin, member, viewer
  invitedBy   String?   @map("invited_by")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter     User?     @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([projectId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id          String    @id @default(uuid())
  teamId      String    @map("team_id")
  projectId   String?   @map("project_id")

  email       String
  role        String    // admin, member, viewer
  token       String    @unique

  invitedBy   String    @map("invited_by")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter     User      @relation("InvitedTeamMember", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([token])
  @@index([email])
  @@map("team_invitations")
}

model TeamProject {
  id          String    @id @default(uuid())
  teamId      String    @map("team_id")
  projectId   String    @map("project_id")

  addedBy     String    @map("added_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     Project   @relation("TeamProjects", fields: [projectId], references: [id], onDelete: Cascade)
  adder       User      @relation("ProjectAdder", fields: [addedBy], references: [id], onDelete: Cascade)

  @@unique([teamId, projectId])
  @@index([teamId])
  @@index([projectId])
  @@map("team_projects")
}

model ActivityLog {
  id          String    @id @default(uuid())
  teamId      String?   @map("team_id")
  projectId   String?   @map("project_id")
  userId      String    @map("user_id")

  action      String    // project_created, member_invited, analysis_run, etc.
  entityType  String?   @map("entity_type") // project, analysis, member, etc.
  entityId    String?   @map("entity_id")

  metadata    Json?     // Additional context data

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User      @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============================================================================
// API ACCESS
// ============================================================================

model ApiKey {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")

  name        String
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix") // for display: "sk_live_abc..."

  permissions Json?     // Scoped permissions: { "projects": ["read", "write"], "analyses": ["read"] }

  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs   ApiUsageLog[]

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model ApiUsageLog {
  id            String    @id @default(uuid())
  apiKeyId      String    @map("api_key_id")

  endpoint      String
  method        String
  statusCode    Int       @map("status_code")
  responseTime  Int?      @map("response_time") // milliseconds

  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")

  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  apiKey        ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
  @@map("api_usage_logs")
}

model Webhook {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  projectId     String?   @map("project_id")

  name          String
  url           String
  events        String[]  // analysis_completed, rank_changed, issue_detected, etc.
  secret        String    // for signature verification

  isActive      Boolean   @default(true) @map("is_active")

  lastTriggeredAt DateTime? @map("last_triggered_at")
  failureCount  Int       @default(0) @map("failure_count")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  user          User      @relation("UserWebhooks", fields: [userId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@index([userId])
  @@index([projectId])
  @@map("webhooks")
}

model WebhookDelivery {
  id            String    @id @default(uuid())
  webhookId     String    @map("webhook_id")

  event         String
  payload       Json
  statusCode    Int?      @map("status_code")
  response      String?
  error         String?

  attempts      Int       @default(1)
  deliveredAt   DateTime? @map("delivered_at")

  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ============================================================================
// USAGE TRACKING
// ============================================================================

model UsageLog {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")

  action      String    // analysis, site_audit, api_call
  creditsUsed Int       @default(1) @map("credits_used")

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_logs")
}
