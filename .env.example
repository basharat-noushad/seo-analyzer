# ==============================================================================
# SEO Analyzer Platform - Environment Variables
# ==============================================================================
# Copy this file to .env.local for development
# For Vercel: Set these in Project Settings → Environment Variables
# Generate secrets with: openssl rand -base64 32
# ==============================================================================

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================
# PostgreSQL connection string with SSL and connection pooling for Vercel
# Format: postgresql://user:password@host:5432/dbname?sslmode=require

# For Vercel Postgres (Recommended):
DATABASE_URL="postgresql://user:password@host.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"

# For Supabase (use connection pooling):
# DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# For Neon (serverless):
# DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# For local development:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seo_analyzer"

# Direct URL for migrations (without pooling)
DIRECT_URL="${DATABASE_URL}"

# =============================================================================
# AUTHENTICATION (NextAuth.js)
# =============================================================================
# Your application URL
NEXTAUTH_URL="http://localhost:3000"

# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# OAuth Providers (Optional - remove if not using)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# =============================================================================
# BILLING & PAYMENTS (Stripe)
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook secret from Stripe CLI or Dashboard
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs for subscription plans (create in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_AGENCY_MONTHLY=""

# =============================================================================
# EMAIL SERVICE (Optional - for alerts & notifications)
# =============================================================================
# Resend: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# =============================================================================
# REDIS (Optional - for rate limiting & caching)
# =============================================================================
# Upstash: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Legacy support
REDIS_URL=""

# =============================================================================
# RATE LIMITING (Fallback if no Redis)
# =============================================================================
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=3600000

# =============================================================================
# EXTERNAL APIs (For Phase 2+)
# =============================================================================
# Google APIs (Search Console, Analytics, PageSpeed Insights)
GOOGLE_API_KEY=""

# DataForSEO (Keyword research & SERP data)
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# SerpApi (SERP tracking)
SERPAPI_KEY=""

# =============================================================================
# BACKGROUND JOBS (For Phase 4+)
# =============================================================================
# Inngest: https://inngest.com
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# =============================================================================
# GOOGLE ADSENSE (Current Feature)
# =============================================================================
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID="ca-pub-XXXXXXXXXXXX"

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
