# SEO Analyzer - Environment Variables

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=3600000

# Optional: Redis for production rate limiting
# REDIS_URL=redis://localhost:6379

# Optional: Google AdSense (for frontend integration)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_1=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_2=0987654321
# NEXT_PUBLIC_ADSENSE_SLOT_3=1122334455

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
