# ==============================================================================
# SEO Analyzer Platform - Environment Variables
# ==============================================================================
# Copy this file to .env.local for development
# For Vercel: Set these in Project Settings → Environment Variables
# Generate secrets with: openssl rand -base64 32
# ==============================================================================

# =============================================================================
# DATABASE (REQUIRED)
# =============================================================================
# PostgreSQL connection string with SSL and connection pooling
# Using Neon Serverless Postgres (Recommended for Vercel)

# DATABASE_URL - Pooled connection for app queries (required)
# Use the pooled connection string from Neon dashboard (ends with ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL - Direct connection for migrations (required for Neon)
# Use the direct connection string from Neon dashboard (not pooled)
DIRECT_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Alternative providers:
# For Vercel Postgres:
# DATABASE_URL="postgresql://user:password@host.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"
# DIRECT_URL="${DATABASE_URL}"

# For Supabase:
# DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# For local development:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seo_analyzer"
# DIRECT_URL="${DATABASE_URL}"

# =============================================================================
# AUTHENTICATION (NextAuth.js)
# =============================================================================
# Your application URL
NEXTAUTH_URL="http://localhost:3000"

# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# OAuth Providers (Optional)
# Google OAuth is configured in lib/auth-config.ts
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# BILLING & PAYMENTS (Stripe)
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook secret from Stripe CLI or Dashboard
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs for subscription plans (create in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_AGENCY_MONTHLY=""

# =============================================================================
# EMAIL SERVICE (Optional - for alerts & notifications)
# =============================================================================
# Resend: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# =============================================================================
# REDIS (Optional - for rate limiting & caching)
# =============================================================================
# Upstash: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Legacy support
REDIS_URL=""

# =============================================================================
# RATE LIMITING (Fallback if no Redis)
# =============================================================================
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=3600000

# =============================================================================
# EXTERNAL APIs (For Phase 2+)
# =============================================================================
# Google APIs (Search Console, Analytics, PageSpeed Insights)
GOOGLE_API_KEY=""

# DataForSEO (Keyword research & SERP data)
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# SerpApi (SERP tracking)
SERPAPI_KEY=""

# =============================================================================
# BACKGROUND JOBS (For Phase 4+)
# =============================================================================
# Inngest: https://inngest.com
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# =============================================================================
# GOOGLE ADSENSE (Current Feature)
# =============================================================================
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID="ca-pub-XXXXXXXXXXXX"

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
